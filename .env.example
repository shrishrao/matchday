# ===== Matchday environment settings =====
# Copy this file to .env and change the values. Never commit .env.

# ===== PostgreSQL (Stage 1) =====
POSTGRES_USER=matchday
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=matchday
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ===== API connection pool (Stage 2) =====
POOL_MIN_SIZE=2
POOL_MAX_SIZE=10
POOL_TIMEOUT_SECONDS=5

# ===== Redis (Stage 1) =====
REDIS_PASSWORD=change-me-to-a-different-long-random-value
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ===== Cache (Stage 7) =====
# Off by default, so the unprotected baseline stays the default. Restart the API after changing.
CACHE_ENABLED=false
# How long each response may be served from the cache, in seconds.
CACHE_TTL_MATCH_SECONDS=5
CACHE_TTL_FEED_SECONDS=2
CACHE_TTL_STATS_SECONDS=10
